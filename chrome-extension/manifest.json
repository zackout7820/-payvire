{
  "manifest_version": 3,
  "name": "Payvire Curseur Arc-en-ciel",
  "description": "Change la forme du curseur avec arc-en-ciel, coeur, étoile et plus.",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Changer le curseur"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
